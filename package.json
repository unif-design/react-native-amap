{
  "name": "@unif/react-native-amap",
  "version": "0.1.0",
  "description": "Unif React Native 高德地图、选点、定位与地点查询",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "unif-react-native-amap-source": {
        "browser": "./src/index.web.ts",
        "default": "./src/index.ts"
      },
      "types": "./lib/typescript/src/index.d.ts",
      "browser": "./lib/web/index.web.js",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "NOTICE"
  ],
  "scripts": {
    "example": "yarn workspace @unif/react-native-amap-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build && node scripts/build-web.cjs",
    "typecheck": "tsc --noEmit && yarn example typecheck",
    "lint": "eslint src __tests__ example/src scripts --max-warnings=0",
    "test": "jest --watchman=false \"$@\" && node --test __tests__/map/MapPicker/sdk/*.test.cjs && yarn test:package",
    "build": "bob build && node scripts/build-web.cjs",
    "release": "release-it --only-version",
    "website": "yarn workspace @unif/react-native-amap-website",
    "test:sdk": "jest --watchman=false --runInBand --testPathPatterns=/sdk/ && node --test __tests__/map/MapPicker/sdk/*.test.cjs",
    "test:package": "yarn build && node --test scripts/check-web.test.cjs"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unif-design/react-native-amap.git"
  },
  "author": "unif-design",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/unif-design/react-native-amap/issues"
  },
  "homepage": "https://unif-design.github.io/react-native-amap/",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@callstack/liquid-glass": "0.8.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "@unif/react-native-design": "1.13.6",
    "@unif/react-native-icons": "0.5.3",
    "@unif/react-native-logger": "0.1.3",
    "commitlint": "^21.2.1",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "expo": "58.0.20",
    "expo-gaode-map": "2.3.2",
    "expo-modules-core": "58.0.27",
    "hermes-eslint": "0.37.0",
    "jest": "^30.5.2",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-blob-util": "0.25.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-gesture-handler": "3.4.0",
    "react-native-keyboard-controller": "1.22.8",
    "react-native-permissions": "5.6.3",
    "react-native-reanimated": "4.7.1",
    "react-native-reanimated-carousel": "5.2.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-worklets": "0.13.0",
    "release-it": "^21.0.1",
    "test-renderer": "1.3.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "zustand": "5.0.16"
  },
  "peerDependencies": {
    "@unif/react-native-design": "1.13.6",
    "@unif/react-native-icons": "0.5.3",
    "@unif/react-native-logger": "0.1.3",
    "expo": "58.0.20",
    "expo-gaode-map": "2.3.2",
    "expo-modules-core": "58.0.27",
    "react": "^19.3.0",
    "react-native": ">=0.88.0",
    "react-native-gesture-handler": "3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zustand": "5.0.16"
  },
  "workspaces": [
    "example",
    "website"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint"
    ],
    "version": "0.64.0"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: 发布 ${version} [skip ci]",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "resolutions": {
    "@react-native/eslint-config/eslint-plugin-ft-flow": "3.0.11"
  }
}
